{
  "name": "armwrestling-science-3d",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "copy-models": "node scripts/compress-models.mjs && node scripts/copy-models.mjs",
    "dev": "npm run copy-models && vite",
